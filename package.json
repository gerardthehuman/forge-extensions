{
  "name": "@forge/extensions",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun --filter '*' --if-present build",
    "check": "oxlint --type-aware && oxfmt --check .",
    "fix": "oxlint --type-aware --fix && oxfmt --write .",
    "postinstall": "lefthook install",
    "test": "bun --filter '*' --if-present test",
    "sandbox": "bun run sandbox/run.ts"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "18.6.1",
    "@oh-my-pi/pi-coding-agent": "18.6.1",
    "@opencode/cli": "2.1.4",
    "@types/bun": "1.3.10",
    "lefthook": "2.2.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "ultracite": "^8.1.0"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "@opencode/cli"
  ]
}
